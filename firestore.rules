
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- হেল্পার ফাংশনসমূহ ---
    
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'dlswf.roy@gmail.com'
      );
    }

    function hasUserData() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPermission(permission) {
      return isAuthed() && (
        isAdmin() || 
        (hasUserData() && permission in getUserData().get('permissions', []))
      );
    }

    // --- কালেকশন ভিত্তিক রুলস ---

    match /users/{userId} {
      allow get: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow list: if isAuthed(); 
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /students/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:students') || hasPermission('special:edit-student') || isAdmin();
      allow delete: if isAdmin() || hasPermission('special:delete-student');
    }
    
    match /staff/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:staff') || isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:attendance') || hasPermission('input:quick-roll-attendance') || hasPermission('input:missed-attendance') || isAdmin();
      allow delete: if isAdmin() || hasPermission('manage:attendance');
    }
    
    match /results/{id} {
      allow read: if true;
      allow write: if hasPermission('input:results') || hasPermission('manage:results') || isAdmin();
      allow delete: if isAdmin();
    }

    match /specialResults/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:special-results') || isAdmin();
      allow delete: if isAdmin();
    }

    match /feeCollections/{id} {
      allow read: if isAuthed();
      allow create, update: if hasPermission('collect:fees') || isAdmin();
      allow delete: if isAdmin() || hasPermission('special:delete-transaction');
    }

    match /fees/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('collect:fees') || isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAuthed();
      allow write, delete: if hasPermission('manage:transactions') || hasPermission('collect:fees') || isAdmin();
    }

    match /notices/{id} {
      allow read: if true; 
      allow write: if hasPermission('manage:notices') || isAdmin();
      allow delete: if isAdmin() || hasPermission('manage:notices');
    }

    match /holidays/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('manage:settings');
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /classRoutines/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:routines') || isAdmin();
    }

    match /teacherAllocations/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:routines') || isAdmin();
    }

    match /proxyClasses/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:proxy-classes') || isAdmin();
    }

    match /lessonPlans/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:lesson-plans') || isAdmin();
      allow delete: if isAdmin();
    }

    match /syllabi/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:syllabus') || isAdmin();
    }

    match /admissionApplications/{id} {
      allow create: if true;
      allow read, write: if hasPermission('manage:admissions') || isAdmin();
    }

    match /publicExamRecords/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:public-records') || isAdmin();
      allow delete: if isAdmin();
    }

    match /archivedDocuments/{id} {
      allow read: if hasPermission('view:archive') || isAdmin();
      allow write: if hasPermission('manage:archive') || isAdmin();
    }

    match /archiveFolders/{id} {
      allow read: if hasPermission('view:archive') || isAdmin();
      allow write: if hasPermission('manage:archive') || isAdmin();
    }

    match /diary/{id} {
      allow read, write: if isAuthed() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthed();
    }

    match /books/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pdf-sheets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{id} {
      allow read, write: if isAuthed();
    }

    match /lecture-sheets/{id} {
      allow read, write: if isAuthed();
    }

    match /school/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /staffAttendance/{id} {
      allow read: if true;
      allow write: if hasPermission('manage:staff-attendance') || isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if isAuthed();
      allow create: if hasPermission('send:messaging') || isAdmin();
      allow update, delete: if hasPermission('manage:messaging') || isAdmin();
    }
  }
}
